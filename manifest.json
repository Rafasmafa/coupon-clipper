{
  "manifest_version": 3,
  "name": "ShopRite Coupon Clipper",
  "version": "1.0",
  "description": "Automatically clips all available coupons in your ShopRite account",
  "permissions": [
    "storage",
    "cookies",
    "activeTab",
    "scripting",
    "webRequest",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://*.shoprite.com/*",
    "https://shop-rite-web-prod.azurewebsites.net/*",
    "https://sts.shoprite.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["getWindow.js"],
      "matches": [
        "https://*.shoprite.com/*",
        "https://shop-rite-web-prod.azurewebsites.net/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.shoprite.com/*",
        "https://*.shoprite.com/*",
        "https://shop-rite-web-prod.azurewebsites.net/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}